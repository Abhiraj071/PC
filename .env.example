# ScanShield Environment Configuration

# Application
APP_NAME=ScanShield
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security / Authentication
JWT_SECRET=scanshield_super_secret_jwt_key_2026_sih
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# PostgreSQL Production: postgresql://postgres:password@localhost:5432/scanshield_db
# Local SQLite Fallback: sqlite:///./scanshield.db
DATABASE_URL=sqlite:///./scanshield.db

# Storage Directories
UPLOAD_DIR=storage/uploads
PREPROCESSED_DIR=storage/preprocessed
REPORT_DIR=storage/reports

# OCR / Tesseract Path (If custom binary location on Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
